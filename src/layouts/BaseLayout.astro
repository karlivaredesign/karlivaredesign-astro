---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Karli Vare' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://use.typekit.net/prx0joo.css" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <main class="page-shell">
      <div class="page-grid">
        <slot />
        <div class="grid-span-full">
          <Footer />
        </div>
      </div>
    </main>
  </body>
</html>