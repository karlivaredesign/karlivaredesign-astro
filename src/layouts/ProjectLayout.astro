---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';

interface Props {
    title?: string;
    heroOverlayStyle?: 'light' | 'dark';
}

const { title = 'Karli Vare', heroOverlayStyle = 'light' } = Astro.props;
const useHeroNavTheme = heroOverlayStyle === 'dark';
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="stylesheet" href="https://use.typekit.net/prx0joo.css" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <title>{title}</title>
    </head>
    <body>
        <div class="project-layout__nav">
            <Navigation variant={useHeroNavTheme ? 'dark' : 'light'} />
        </div>
        <slot name="hero" />
        <main class="page-shell">
            <div class="page-grid">
                <slot />
                <div class="grid-span-full">
                    <Footer />
                </div>
            </div>
        </main>
        {useHeroNavTheme && (
            <script>
                function initHeroNavTheme() {
                    const nav = document.querySelector('.project-layout__nav nav.navigation');
                    const hero = document.querySelector('.project-hero');

                    if (!nav || !hero) return;

                    const observer = new IntersectionObserver(
                        ([entry]) => {
                            if (entry.isIntersecting) {
                                nav.setAttribute('data-theme', 'dark');
                            } else {
                                nav.removeAttribute('data-theme');
                            }
                        },
                        { threshold: 0 },
                    );

                    observer.observe(hero);
                }

                initHeroNavTheme();
            </script>
        )}
    </body>
</html>

<style>
    /* Fixed nav overlays the hero; no flow offset before main content */
    .project-layout__nav :global(.navigation-offset) {
        display: none;
    }
</style>
