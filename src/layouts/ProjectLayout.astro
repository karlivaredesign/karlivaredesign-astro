---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';

interface Props {
    title?: string;
}

const { title = 'Karli Vare' } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="stylesheet" href="https://use.typekit.net/prx0joo.css" />
        <title>{title}</title>
    </head>
    <body>
        <div class="project-layout__nav">
            <Navigation variant="light" />
        </div>
        <slot name="hero" />
        <main class="page-shell">
            <div class="page-grid">
                <slot />
                <div class="grid-span-full">
                    <Footer />
                </div>
            </div>
        </main>
    </body>
</html>

<style>
    /* Fixed nav overlays the hero; no flow offset before main content */
    .project-layout__nav :global(.navigation-offset) {
        display: none;
    }
</style>
