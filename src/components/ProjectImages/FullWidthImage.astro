---
import ProjectImage from './ProjectImage.astro';
import type { ImageVariant, ProjectFrameMedia } from './types';

export type Props = ProjectFrameMedia & {
    /** Frame aspect ratio — default landscape; use `landscapeWide` (1360×630) for wide stills. */
    variant?: Extract<ImageVariant, 'landscape' | 'landscapeWide'>;
};

const { variant = 'landscape', ...media } = Astro.props;
---

<ProjectImage {...media} variant={variant} />
