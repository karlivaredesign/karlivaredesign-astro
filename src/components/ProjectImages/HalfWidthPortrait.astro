---
import ProjectImage from './ProjectImage.astro';
import type { ImageVariant, ProjectFrameMedia } from './types';

export type Props = {
    images: [ProjectFrameMedia, ProjectFrameMedia];
    /** Frame aspect ratio — default portrait; use `portraitTall` (644×822) for tall portrait videos. */
    variant?: Extract<ImageVariant, 'portrait' | 'portraitTall'>;
};

const { images, variant = 'portrait' } = Astro.props;
---

<div class="project-images-row">
    <ProjectImage {...images[0]} variant={variant} />
    <ProjectImage {...images[1]} variant={variant} />
</div>
