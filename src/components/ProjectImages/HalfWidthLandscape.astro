---
import ProjectImage from './ProjectImage.astro';
import type { ProjectFrameMedia } from './types';

export type Props = {
    images: [ProjectFrameMedia, ProjectFrameMedia];
};

const { images } = Astro.props;
---

<div class="project-images-row">
    <ProjectImage {...images[0]} variant="landscape" />
    <ProjectImage {...images[1]} variant="landscape" />
</div>
