---
import ProjectImage from './ProjectImage.astro';
import type { ProjectFrameMedia } from './types';

export type Props = {
    landscape: ProjectFrameMedia;
    portrait: ProjectFrameMedia;
    reverse?: boolean;
};

const { landscape, portrait, reverse = false } = Astro.props;
---

<div class:list={['project-images-mixed', { 'project-images-mixed--reverse': reverse }]}>
    <div class="project-images-mixed__landscape">
        <ProjectImage {...landscape} variant="fill" />
    </div>
    <div class="project-images-mixed__portrait">
        <ProjectImage {...portrait} variant="fill" />
    </div>
</div>
