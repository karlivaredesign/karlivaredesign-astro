---
export type Props = {
    year: number | string;
};

const { year } = Astro.props;
---

<span class="year-tag">year : {year}</span>

<style>
    .year-tag {
        display: inline-flex;
        width: fit-content;
        padding: 8px 16px;
        font-family: var(--font-heading);
        font-weight: 400;
        font-size: 14px;
        line-height: 1.4;
        letter-spacing: 0;
        border-radius: 16px;
        background: rgb(88 85 81 / 8%);
    }
</style>
