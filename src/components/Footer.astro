---
import linkedInIcon from '../assets/icons/LinkedIn.svg';
import emailIcon from '../assets/icons/Email.svg';
---

<footer class="footer" aria-label="Site footer">
    <p class="heading-3-sm footer__copyright">©karli vare design 2026</p>

    <div class="footer__socials" aria-label="Social links">
        <a
            class="footer__icon-link"
            href="https://www.linkedin.com/in/karli-vare/"
            aria-label="LinkedIn"
        >
            <img class="footer__icon" src={linkedInIcon.src} alt="" />
        </a>
        <a
            class="footer__icon-link"
            href="mailto:karlivaredesign@gmail.com"
            aria-label="Email"
        >
            <img class="footer__icon" src={emailIcon.src} alt="" />
        </a>
    </div>
</footer>

<style>
    .footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 24px;
        padding: 40px 0;
        border-top: 1px solid var(--color-charcoal);
    }

    .footer p {
        margin: 0;
    }

    .footer__socials {
        display: flex;
        align-items: center;
        gap: 32px;
    }

    .footer__icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: inherit;
        text-decoration: none;
        border: 0;
        border-radius: 0;
        outline: none;
        box-shadow: none;
    }

    .footer__icon-link:focus,
    .footer__icon-link:focus-visible {
        outline: none;
        box-shadow: none;
    }

    .footer__icon {
        display: block;
        width: 32px;
        height: auto;
        border: 0;
        border-radius: 0;
        outline: none;
        box-shadow: none;
    }

    @media (min-width: 768px) {
        .footer {
            flex-direction: row;
            justify-content: space-between;
        }

        .footer__copyright {
            font-family: var(--font-heading);
            font-weight: 400;
            font-size: 32px;
            line-height: 132%;
            letter-spacing: -4%;
        }

        .footer__icon {
            width: 40px;
        }
    }
</style>
